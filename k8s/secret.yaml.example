# Template only: never apply these placeholders or commit generated values.
# The harness generates private synthetic values under ignored reports/.
apiVersion: v1
kind: Secret
metadata:
  name: smartdesk-local
  namespace: smartdesk-lab
type: Opaque
stringData:
  POSTGRES_DB: smartdesk_lab
  POSTGRES_USER: smartdesk_lab
  POSTGRES_PASSWORD: REPLACE_WITH_UNIQUE_SYNTHETIC_LOCAL_PASSWORD
  SMARTDESK_SESSION_SECRET: REPLACE_WITH_UNIQUE_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARACTERS
