# Copy to .env only when that file does not already exist.
# Replace both placeholders locally. Never commit .env or reuse real credentials.
POSTGRES_DB=smartdesk
POSTGRES_USER=smartdesk
# Use a unique random URL-safe password: letters, digits, '-' and '_'.
# Compose currently embeds this value in DATABASE_URL without percent encoding.
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_URL_SAFE_PASSWORD
# Generate a different random value with at least 32 characters.
SMARTDESK_SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARACTERS

# Local loopback HTTP demonstration only. Use true with HTTPS.
SMARTDESK_COOKIE_SECURE=false
SMARTDESK_SESSION_MAX_AGE=3600
# Keep automatic demonstration-account creation disabled.
SMARTDESK_SEED_DEMO_USERS=0
