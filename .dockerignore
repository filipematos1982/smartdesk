# Deny everything unless explicitly needed by the local image.
**
!Dockerfile
!.dockerignore
!requirements.txt
!src/
!src/**
!scripts/
!scripts/**
!tests/
!tests/**
!features/
!features/**

# Exclude local state and secrets even inside an allowed directory.
**/.git
**/.git/**
**/.env
**/.env.*
**/.aws
**/.aws/**
**/.azure
**/.azure/**
**/.kube
**/.kube/**
**/.ssh
**/.ssh/**
**/.docker
**/.docker/**
**/*kubeconfig*
**/*credentials*.json
**/*service-account*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.venv
**/.venv/**
**/venv
**/venv/**
**/__pycache__
**/__pycache__/**
**/.pytest_cache
**/.pytest_cache/**
**/*.pyc
**/*.pyo
**/*.db
**/*.sqlite3
**/*.sqlite
**/.coverage
**/htmlcov
**/htmlcov/**
**/reports
**/reports/**
